# 이 파일은 "어떤 키가 필요한지" 알려 주는 견본이에요. 실제 값은 넣지 마세요.
# 실제 값은 같은 폴더에 `.env.local` 파일을 만들어 거기에만 적어요. (.env.local은 인터넷에 올라가지 않아요)

# Supabase 프로젝트 설정 화면(Project Settings > API)에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버에서만 쓰는 비밀 키. 절대 화면 코드나 채팅에 붙여넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 푸시 알림 키 (npx web-push generate-vapid-keys 로 만들어요)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:본인이메일@example.com

# 24h/48h 점검 주소를 아무나 호출하지 못하게 막는 비밀 문자열 (아무 긴 글자나 정해요)
CRON_SECRET=
