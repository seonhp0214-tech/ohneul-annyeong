# 이 파일은 "어떤 키가 필요한지" 알려 주는 견본이에요. 실제 값은 여기에 넣지 마세요.
# 실제 값은 같은 폴더의 `.env.local` 파일에 적고(인터넷에 올라가지 않아요),
# 배포할 때는 Vercel > Project > Settings > Environment Variables 에 똑같이 넣어요.
# 키가 하나도 없어도 앱은 "연습 모드"로 동작해요.

# ---- 공개해도 되는 값 (브라우저에서 쓰여요) -------------------------------
# Supabase 대시보드 > Project Settings > API 의 "Project URL"
NEXT_PUBLIC_SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API 의 "anon public" 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 푸시 알림용 공개 키. 터미널에서 `npx web-push generate-vapid-keys` 로 만든 "Public Key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- 비밀 값 (서버에서만 써요. 채팅/화면/GitHub 에 절대 붙여넣지 마세요) -----
# Supabase 대시보드 > Project Settings > API 의 "service_role" 키. 모든 보호를 우회하는 강력한 키예요.
SUPABASE_SERVICE_ROLE_KEY=
# 위 `generate-vapid-keys` 로 만든 "Private Key"
VAPID_PRIVATE_KEY=
# 푸시 서비스에 알려 주는 연락처. mailto: 뒤에 본인 이메일 (예: mailto:me@example.com)
VAPID_SUBJECT=
# 자동 점검 주소를 아무나 호출하지 못하게 막는 비밀 문자열. 길고 아무렇게나 정한 글자 (20자 이상 권장).
# supabase/cron.sql 에 넣는 값과 똑같아야 해요.
CRON_SECRET=
